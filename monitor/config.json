{
  "user": "demo02_monitor",
  "statusPageUrl": "https://jpleiades.github.io/monitor_ge/",
  "alertTo": "javier.garrido@globaleduca.com",
  "alertSubject": "CAIDA",
  "timeoutMs": 45000,
  "retries": 1,
  "retentionHours": 24,
  "minBodyChars": 20,
  "modules": [
    {
      "id": "psp",
      "name": "PSP",
      "url": "https://psp.globaleduca.com/demo02"
    },
    {
      "id": "meta",
      "name": "Meta",
      "url": "https://meta.globaleduca.com/demo02",
      "okTexts": [
        "No tiene permisos para acceder a la plataforma de Meta"
      ]
    },
    {
      "id": "portal",
      "name": "Portal",
      "url": "https://portal.globaleduca.com/demo02"
    },
    {
      "id": "cuaderno",
      "name": "Cuaderno",
      "url": "https://cuaderno.globaleduca.com/demo02"
    },
    {
      "id": "admin",
      "name": "Admin",
      "url": "https://admin.globaleduca.com/demo02"
    }
  ],
  "selectors": {
    "userText": "Usuario",
    "passwordText": "Contraseña",
    "user": "input[name*='user' i], input[id*='user' i], input[name*='login' i], input[id*='login' i], input[name*='email' i], input[type='email']",
    "password": "input[type='password']",
    "submit": [
      ":text-is('Iniciar sesión')",
      "button[type='submit']",
      "input[type='submit']"
    ],
    "logout": [
      ":text-is('Cerrar sesión')",
      ":text-is('Cerrar Sesión')",
      ":text-is('Desconectar')",
      ":text-is('Salir')",
      "a[href*='logout' i]",
      "a[href*='logoff' i]",
      "a[href*='desconectar' i]"
    ]
  },
  "errorTexts": [
    "Internal Server Error",
    "Service Unavailable",
    "Bad Gateway",
    "Gateway Time-out",
    "Gateway Timeout",
    "Fatal error",
    "Stack trace",
    "Whitelabel Error Page",
    "Server Error in",
    "Usuario o contraseña incorrectos",
    "Credenciales incorrectas"
  ]
}
